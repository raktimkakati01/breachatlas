# The database password is generated by Terraform and stored in Secrets Manager
# — it never appears in code, tfvars, or the console. ECS injects it into the
# containers at launch (see ecs.tf), so the plaintext lives only in the task's
# memory, never in an environment variable baked into an image or task def.
resource "random_password" "db" {
  length  = 32
  special = true
  # Exclude characters that are awkward in PostgreSQL URLs / shell contexts.
  override_special = "!#%*-_=+"
}

resource "aws_secretsmanager_secret" "db" {
  name                    = "${local.name}/db/credentials"
  description             = "RDS master credentials and connection URL for BreachAtlas."
  kms_key_id              = aws_kms_key.main.arn
  recovery_window_in_days = 7
}

# The secret is a JSON blob with everything a service needs to build its
# DATABASE_URL, plus the discrete fields for other consumers.
resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id
  secret_string = jsonencode({
    username = var.db_username
    password = random_password.db.result
    host     = aws_db_instance.main.address
    port     = aws_db_instance.main.port
    dbname   = var.db_name
    url      = "postgresql+psycopg://${var.db_username}:${random_password.db.result}@${aws_db_instance.main.address}:${aws_db_instance.main.port}/${var.db_name}"
  })
}
