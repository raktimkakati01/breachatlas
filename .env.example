# BreachAtlas — example environment. Copy to .env and fill in LOCAL values.
# NEVER put real secrets here or in git. .env is git-ignored.

# --- PostgreSQL (local docker compose) ---
POSTGRES_USER=breachatlas
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=breachatlas
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# Full SQLAlchemy URL. For docker compose, host is the service name "db".
DATABASE_URL=postgresql+psycopg://breachatlas:change_me_locally@db:5432/breachatlas

# Comma-separated CORS origins (frontend dev server added in Phase 6)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Public API read rate limit (requests / minute / client IP)
API_RATE_LIMIT=60

# Environment name: local | ci | production
APP_ENV=local
